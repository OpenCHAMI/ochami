{
  "_comment": "cloud-init processing results, verified by scripts/cloud-init-reference.py with the embedded render helper. Run it with --write to regenerate expected values.",
  "cases": [
    {
      "name": "groups merged in order",
      "user_data": "#cloud-config\n",
      "vendor_data": "#include\nhttp://ci.example/cloud-init/a.yaml\nhttp://ci.example/cloud-init/b.yaml\n",
      "includes": {
        "http://ci.example/cloud-init/a.yaml": {
          "status": "resolved",
          "content": "#cloud-config\nhostname: a\nruncmd: [echo a]\nmounts: [[a, /a]]\n"
        },
        "http://ci.example/cloud-init/b.yaml": {
          "status": "resolved",
          "content": "#cloud-config\nruncmd: [echo b]\nhostname: b\n"
        }
      },
      "instance_data": {
        "ds": {
          "meta_data": {
            "instance-id": "i-1",
            "local-hostname": "node1",
            "groups": {
              "compute": {
                "role": "worker"
              }
            }
          }
        },
        "v1": {
          "instance_id": "i-1",
          "local_hostname": "node1"
        }
      },
      "expected": {
        "user": {
          "failed": false,
          "parts": [
            [
              "part-001",
              "dropped"
            ]
          ]
        },
        "vendor": {
          "failed": false,
          "parts": [
            [
              "part-001",
              "merged"
            ],
            [
              "part-002",
              "merged"
            ]
          ],
          "disabled": false
        },
        "merged": {
          "t": "dict",
          "v": [
            [
              "hostname",
              {
                "t": "str",
                "v": "b"
              }
            ],
            [
              "mounts",
              {
                "t": "list",
                "v": [
                  {
                    "t": "list",
                    "v": [
                      {
                        "t": "str",
                        "v": "a"
                      },
                      {
                        "t": "str",
                        "v": "/a"
                      }
                    ]
                  }
                ]
              }
            ],
            [
              "runcmd",
              {
                "t": "list",
                "v": [
                  {
                    "t": "str",
                    "v": "echo b"
                  }
                ]
              }
            ]
          ]
        }
      }
    },
